# Copy this file to `.env` and fill in values. `.env` is gitignored.
#   cp .env.example .env
#
# Everything here is optional — the scraper runs without any of it, but:
#   - Without GEMINI_API_KEY, captcha solving is OCR-only (lower success rate).
#   - Without a proxy file, all requests egress from your own IP.

# Gemini API key used as the captcha fallback (5 OCR attempts -> 5 Gemini attempts).
# Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Path to a newline-delimited proxy list (http://IP:PORT per line).
# See configs/runtime/proxy_ips.txt.example for the format.
# ECOURTS_PROXY_FILE=configs/runtime/proxy_ips.txt

# --- Request tuning (defaults shown; uncomment to override) ---
# ECOURTS_BASE_URL=https://services.ecourts.gov.in/ecourtindia_v6
# MIN_REQUEST_DELAY=2.5
# HTTP_MAX_RETRIES=4
# HTTP_TIMEOUT_SECONDS=30
